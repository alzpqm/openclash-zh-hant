# ==========================================================
# ==== 以下為 YAML 塊覆寫示例 ====
# ==========================================================
# YAML 覆寫塊識別標記
# [YAML]

# ----------------------------------------------------------
# 運算子速查表：
#   key        → 預設合併（Hash 遞迴合併，其他直接覆蓋）
#   key!       → 強制覆蓋整個值
#   key+       → 陣列後置追加
#   +key       → 陣列前置插入
#   key-       → 陣列差集刪除 / 非陣列則刪除該鍵
#   key*       → 批次條件更新（需配合 where/set）
#   <key>字尾  → 同上（+, !, *, -），適用於鍵名含特殊字元時
#   +<key>     → 陣列前置插入，適用於鍵名含特殊字元時
# ----------------------------------------------------------

# 1. 預設合併 - 合併雜湊鍵值，鍵不存在則新增，Hash 值遞迴合併
# 示例：修改 dns.enable 並新增新鍵
# dns:
#   enable: true
#   cache-algorithm: lru

# 示例：直接替換標量值
# mixed-port: 10802
# allow-lan: false

# 示例：合併 tun 配置（僅修改指定欄位，其餘保留）
# tun:
#   enable: true
#   stack: gvisor

# ----------------------------------------------------------

# 2. 強制覆蓋 (key!) - 強制替換整個值，不做遞迴合併
# 示例：替換整個 dns.fake-ip-filter 陣列
# dns:
#   fake-ip-filter!:
#     - '*.lan'
#     - 'new.domain.com'

# 示例：強制覆蓋整個 rules 陣列
# rules!:
#   - DOMAIN-SUFFIX,example.com,DIRECT
#   - MATCH,PROXY

# 示例：使用 <> 強制覆蓋整個 dns 配置（鍵名含特殊字元時）
# <dns>!:
#   enable: false
#   nameserver:
#     - '114.114.114.114'

# ----------------------------------------------------------

# 3. 陣列後置 (key+) - 將新元素追加到陣列末尾
# 示例：向 dns.nameserver 末尾追加 DNS
# dns:
#   nameserver+:
#     - '1.1.1.1'
#     - '8.8.8.8'

# 示例：向 rules 末尾追加規則
# rules+:
#   - DOMAIN-SUFFIX,example.com,REJECT

# 示例：使用 <> 後置
# dns:
#   <nameserver>+:
#     - '8.8.8.8'

# ----------------------------------------------------------

# 4. 陣列前置 (+key / +<key>) - 將新元素插入到陣列開頭
# 示例：向 dns.nameserver 開頭插入 DNS
# dns:
#   +nameserver:
#     - '223.5.5.5'
#     - '119.29.29.29'

# 示例：向 rules 開頭插入規則（優先匹配）
# +rules:
#   - DOMAIN-SUFFIX,priority.com,DIRECT

# 示例：使用 +<> 前置插入（鍵名含特殊字元時）
# dns:
#   +<nameserver>:
#     - '119.29.29.29'

# ----------------------------------------------------------

# 5. 陣列刪除 (key-) - 從陣列中移除指定元素，非陣列則刪除整個鍵
# 示例：從 dns.nameserver 中移除指定 DNS
# dns:
#   nameserver-:
#     - '8.8.8.8'
#     - '8.8.4.4'

# 示例：從 rules 中移除指定規則
# rules-:
#   - DOMAIN-SUFFIX,old.com,REJECT

# 示例：刪除整個鍵（值為 null/~ 或空）
# dns:
#   cache-algorithm-:

# ----------------------------------------------------------

# 6. 批次條件更新 (key*) - 按 where 條件匹配集合元素，用 set 子句更新
#
# 支援的集合型別：
#   - 陣列（元素為 Hash 或 String）
#   - Hash（值為 Hash）
#
# where 條件支援：
#   - 普通值相等：  type: select
#   - 正則匹配：    name: '/^HK/'
#   - 陣列包含：    proxies: ['proxy1']  （檢查陣列是否包含所有指定元素）
#   - Hash 鍵匹配： key: 'some-key'      （僅用於 Hash 型別集合）
#   - 字串匹配：  value: 'some-string' （僅用於字串陣列）
#
# set 子句支援的運算子（同頂層運算子）：
#   field        → 直接覆蓋該欄位
#   field!       → 強制覆蓋該欄位
#   field+       → 陣列後置追加
#   +field       → 陣列前置插入
#   field-       → 陣列差集刪除 / 非陣列則刪除該鍵
#   value        → 替換字串陣列中的匹配項
#   value: ~     → 刪除字串陣列中的匹配項
#   key: ~       → 刪除 Hash 中的匹配鍵（僅 Hash 集合）
#   key-:        → 同上

# 示例：按 type 匹配，替換 proxy-groups 的 proxies
# proxy-groups*:
#   where:
#     type: select
#   set:
#     proxies:
#       - 'new-proxy1'
#       - 'new-proxy2'

# 示例：按 type 匹配，向 proxies 末尾追加節點
# proxy-groups*:
#   where:
#     type: select
#   set:
#     proxies+:
#       - 'new-proxy3'

# 示例：按 type 匹配，向 proxies 開頭插入節點
# proxy-groups*:
#   where:
#     type: url-test
#   set:
#     +proxies:
#       - 'new-proxy1'

# 示例：按 type 匹配，從 proxies 中移除指定節點
# proxy-groups*:
#   where:
#     type: select
#   set:
#     proxies-:
#       - 'old-proxy1'
#       - 'old-proxy2'

# 示例：使用陣列包含條件（proxies 中必須包含指定元素才匹配）
# proxy-groups*:
#   where:
#     type: select
#     proxies:
#       - 'old-proxy1'
#   set:
#     proxies:
#       - 'new-proxy1'
#       - 'new-proxy2'

# 示例：使用正則匹配 name 欄位
# proxy-groups*:
#   where:
#     name: '/^HK/'
#   set:
#     +proxies:
#       - 'hk-new-proxy'

# 示例：刪除 proxy-groups 中某個欄位（set value 為 null/~）
# proxy-groups*:
#   where:
#     name: Proxy
#   set:
#     icon-:

# 示例：按 type 匹配修改 proxies 中 socks5 節點埠
# proxies*:
#   where:
#     type: socks5
#   set:
#     port: 1080

# 示例：更新 hosts Hash 中的指定鍵
# hosts*:
#   where:
#     key: '*.mihomo.dev'
#   set:
#     '*.mihomo.dev': '::1'

# 示例：刪除 hosts Hash 中的匹配鍵
# hosts*:
#   where:
#     key: '*.old.dev'
#   set:
#     key-:

# 示例：替換字串陣列中的匹配項
# rules*:
#   where:
#     value: 'DOMAIN-SUFFIX,old.com,REJECT'
#   set:
#     value: 'DOMAIN-SUFFIX,new.com,DIRECT'

# 示例：使用正則匹配並刪除字串陣列中的規則
# rules*:
#   where:
#     value: '/,REJECT$/'
#   set:
#     value:

# 示例：刪除 fake-ip-filter 中的指定項
# dns:
#   fake-ip-filter*:
#     where:
#       value: '+.localhost.ptlogin2.qq.com'
#     set:
#       value:

# 示例：使用 <> 批次更新
# <proxy-groups>*:
#   where:
#     type: url-test
#   set:
#     interval: 300

# ----------------------------------------------------------

# 7. 組合操作 - 在同一塊內同時使用多個運算子
# 示例：同時前置和後置追加 DNS（必須寫在同一 dns 塊內）
# dns:
#   nameserver+:
#     - '1.0.0.1'
#   +nameserver:
#     - '119.29.29.29'

# 示例：同時刪除舊 DNS 並前置插入新 DNS
# dns:
#   nameserver-:
#     - '8.8.8.8'
#   +nameserver:
#     - '223.5.5.5'

# ----------------------------------------------------------

# 8. <key> 語法補充 - 適用於鍵名含特殊字元時
# 字尾支援：+（後置）、-（刪除）、!（強制覆蓋）、*（批次更新），空串為預設合併
# 前置插入請使用 +<key> 寫法（字首形式）

# 示例：使用 <> 後置追加
# dns:
#   <nameserver>+:
#     - '8.8.8.8'

# 示例：使用 <> 刪除陣列元素
# dns:
#   <nameserver>-:
#     - '8.8.8.8'

# 示例：使用 <> 強制覆蓋
# dns:
#   <nameserver>!:
#     - '114.114.114.114'

# 示例：使用 <> 批次更新（等同於 key*）
# <proxy-groups>*:
#   where:
#     type: url-test
#   set:
#     interval: 300

# 示例：使用 +<> 前置插入（鍵名含特殊字元時的前置寫法）
# dns:
#   +<nameserver>:
#     - '119.29.29.29'



# ==========================================================
# ==== 以下為可設定的外掛配置引數 ====
# ==========================================================

# CONFIG_FILE (原始配置檔案路徑)
# CORE_TYPE (核心型別 Smart or Meta)

# --- 網路與介面 ---
# LAN_INTERFACE_NAME (LAN 介面名稱)
# INTERFACE_NAME (繫結 wan 介面的名稱)

# --- 控制面板相關 ---
# CN_PORT (控制面板埠)
# DA_PASSWORD (控制面板訪問密碼)

# --- 埠相關 ---
# PROXY_PORT (Redir代理埠)
# TPROXY_PORT (TPROXY代理埠)
# HTTP_PORT (HTTP 代理埠)
# SOCKS_PORT (SOCKS 代理埠)
# MIXED_PORT (混合代理埠)
# DNS_PORT (DNS 監聽埠)

# --- DNS 相關 ---
# ENABLE_REDIRECT_DNS (DNS 重定向模式，0：禁用，1：Dnsmasq Redirect, 2：Firewall Redirect)
# ENABLE_CUSTOM_DNS (自定義 DNS, 0: 外掛不覆寫, 1: 啟用，使用外掛內建規則)
# APPEND_DEFAULT_DNS (自動追加 default-nameserver DNS, 0: 外掛不覆寫, 1: 啟用)
# APPEND_WAN_DNS (追加上游分配 DNS, 0: 外掛不覆寫, 1: 啟用)
# STORE_FAKEIP (啟用 fake-ip 快取, 0: 外掛不覆寫, 1: 啟用)
# CUSTOM_FAKEIP_FILTER (啟用 Fake-IP-Filter, 0: 外掛不覆寫, 1: 啟用，使用外掛內建規則)
    # CUSTOM_FAKEIP_FILTER_MODE (Fake-IP 過濾模式, blacklist/whitelist)
# FAKEIP_RANGE (自定義 Fake-IP 地址段, 如 198.18.0.1/16)
# ENABLE_RESPECT_RULES (DNS 查詢是否遵循規則, 0: 外掛不覆寫, 1: 啟用)
# CUSTOM_NAME_POLICY (自定義 Nameserver-Policy, 0: 外掛不覆寫, 1: 啟用，使用外掛內建規則)
# CUSTOM_HOST (自定義 Hosts, 0: 外掛不覆寫, 1: 啟用，使用外掛內建規則)
# CUSTOM_FALLBACK_FILTER (自定義 Fallback-Filter, 0: 外掛不覆寫, 1: 啟用，使用外掛內建規則)

# --- IPv6 相關 ---
# IPV6_ENABLE (啟用 IPv6，0: 禁用, 1: 啟用)
# IPV6_DNS (啟用 IPv6 DNS，0: 禁用, 1: 啟用)
# IPV6_MODE (IPv6 代理模式, 0: TProxy Mode, 1: Redirect Mode, 2: TUN Mode, 3: Mix Mode)
# ENABLE_V6_UDP_PROXY (啟用 IPv6 UDP 代理，0: 禁用, 1: 啟用, only for Redirect Mode and Redirect Mode)

# --- 代理與模式 ---
# EN_MODE (外掛執行模式：fake-ip/fake-ip-tun/fake-ip-mix or redir-host/redir-host-tun/redir-host-mix)
# ENABLE_UDP_PROXY (啟用 UDP 代理, 0: 禁用, 1: 啟用, only for EN_MODE_TUN is nil)
# DISABLE_UDP_QUIC (禁用 UDP QUIC, 0: 啟用, 1: 禁用)
# ROUTER_SELF_PROXY (路由器自身代理, 0: 禁用, 1: 啟用)
# STACK_TYPE (TUN 網路棧型別, system/gvisor/mixed, default is system)
# PROXY_MODE (代理模式, rule/global/direct, default is rule)

# --- 防火牆與訪問控制 ---
# INTRANET_ALLOWED (僅允許內網訪問, 0: 禁用, 1: 啟用)
    # INTRANET_ALLOWED_WAN_NAME (僅允許內網時 WAN 介面列表名稱)
# BYPASS_GATEWAY_COMPATIBLE (旁路閘道器相容模式, 0: 禁用, 1: 啟用)
# COMMON_PORTS (繞過常用埠的埠列表, 0: 禁用 or "21 22 23 53 80 123 143 194 443 465 587 853 993 995 998 2052 2053 2082 2083 2086 2095 2096 2197 5222 5223 5228 5229 5230 8080 8443 8880 8888 8889")

# --- 分流相關 ---
# CHINA_IP_ROUTE (IPv4 繞過 IP 模式, 0: 禁用, 1: 繞過大陸, 2: 回國)
# CHINA_IP6_ROUTE (IPv6 繞過 IP 模式, 0: 禁用, 1: 繞過大陸, 2: 回國)
# CHNR_AUTO_UPDATE (大陸IP自動更新, 0: 禁用, 1: 啟用)
# CHNR_UPDATE_WEEK_TIME (大陸IP更新星期, 0-6 or *, 0代表星期天, *代表每天, default 0)
# CHNR_UPDATE_DAY_TIME (大陸IP更新小時, 0-23 or *, default 1)
# CHNR_CUSTOM_URL (大陸IP列表自定義更新地址, URL or default)
# CHNR6_CUSTOM_URL (大陸IPv6列表自定義更新地址, URL or default)
# CHINA_IP_ROUTE_PASS (繞過大陸 IP 時排除類別, 域名、IP or 外掛內建規則, eg: services.googleapis.cn googleapis.cn 114.114.114.114)
# CHINA_IP6_ROUTE_PASS (繞過大陸 IPv6 時排除類別, 域名、IP or 外掛內建規則)

# ENABLE_META_SNIFFER (啟用域名嗅探, 0: 外掛不覆寫, 1: 啟用)
    # ENABLE_META_SNIFFER_CUSTOM (啟用自定義嗅探規則, 0: 外掛不覆寫, 1: 啟用，使用外掛內建規則)
    # ENABLE_META_SNIFFER_PURE_IP (強制嗅探純 IP 連線, 0: 外掛不覆寫, 1: 啟用)

# ENABLE_TCP_CONCURRENT (啟用 TCP 併發, 0: 外掛不覆寫, 1: 啟用)
# FIND_PROCESS_MODE (程序查詢模式, 0: 外掛不覆寫, off: 關閉, always, strict)
# ENABLE_UNIFIED_DELAY (啟用統一延遲計算, 0: 外掛不覆寫, 1: 啟用)

# ENABLE_RULE_PROXY (僅代理命中規則流量, 0: 禁用, 1: 啟用)
# ENABLE_CUSTOM_CLASH_RULES (啟用使用者自定義規則, 0: 禁用, 1: 啟用，使用外掛規則)

# TOLERANCE (URL-Test 策略組切換靈敏度, 毫秒數 or default 0 不覆寫)
# URLTEST_INTERVAL_MOD (測速（連通性）間隔修改, 秒數 or default 0 不覆寫)
# URLTEST_ADDRESS_MOD (測速（連通性）地址修改, URL or default 0 不覆寫)
# GITHUB_ADDRESS_MOD (GitHub 地址修改, URL or default 0 不覆寫)

# --- Smart 相關 ---
# AUTO_SMART_SWITCH (啟用 Smart 自動切換, 0: 外掛不覆寫, 1: 啟用)
# SMART_ENABLE_LGBM (啟用 LightGBM 模型, 0: 外掛不覆寫, 1: 啟用)
# SMART_POLICY_PRIORITY (節點權重加成, 正則或字元，格式：Premium:0.9;SG:1.3)
# SMART_PREFER_ASN (強制查詢並使用 ASN 資訊, 0: 外掛不覆寫, 1: 啟用)
# SMART_COLLECT (模型訓練資料收集, 0: 外掛不覆寫, 1: 啟用)
    # SMART_COLLECT_SIZE (模型訓練資料收集的檔案大小, MB, 數值 or default 100)
    # SMART_COLLECT_RATE (模型訓練資料收集的取樣率, 0-1 or default 1)
# LGBM_AUTO_UPDATE (LGBM 模型自動更新, 0: 外掛不覆寫, 1: 啟用)
    # LGBM_UPDATE_INTERVAL (LGBM 模型更新間隔, 小時數 or default 72)
    # LGBM_CUSTOM_URL (LGBM 模型自定義下載 URL (URL 地址 or default)

# --- 資料庫載入相關 ---
# ENABLE_GEOIP_DAT (啟用 GEOIP DAT 資料庫, 0: 外掛不覆寫, 1: 啟用)
# GEODATA_LOADER (Geo 資料載入模式, memconservative/standard/0: 外掛不覆寫)
# GEO_AUTO_UPDATE (GeoIP MMDB 資料自動更新, 0: 禁用, 1: 啟用)
# GEO_UPDATE_WEEK_TIME (GeoIP MMDB 資料更新日, 0-6 or *, 0代表星期天, *代表每天, default 0)
# GEO_UPDATE_DAY_TIME (GeoIP MMDB 資料更新小時, 0-23 or *, default 1)
# GEO_CUSTOM_URL (GeoIP MMDB 資料自定義更新地址, URL or default)
# GEOIP_AUTO_UPDATE (GeoIP Dat 資料自動更新, 0: 禁用, 1: 啟用)
# GEOIP_UPDATE_WEEK_TIME (GeoIP Dat 資料更新日, 0-6 or *, 0代表星期天, *代表每天, default 0)
# GEOIP_UPDATE_DAY_TIME (GeoIP Dat 資料更新小時, 0-23 or *, default 1)
# GEOIP_CUSTOM_URL (GeoIP Dat 資料自定義更新地址, URL or default)
# GEOSITE_AUTO_UPDATE (GeoSite 資料自動更新, 0: 禁用, 1: 啟用)
# GEOSITE_UPDATE_WEEK_TIME (GeoSite 資料更新日, 0-6 or *, 0代表星期天, *代表每天, default 0)
# GEOSITE_UPDATE_DAY_TIME (GeoSite 資料更新小時, 0-23 or *, default 1)
# GEOSITE_CUSTOM_URL (GeoSite 資料自定義更新地址, URL or default)
# GEOASN_AUTO_UPDATE (GeoASN 資料自動更新, 0: 禁用, 1: 啟用)
# GEOASN_UPDATE_WEEK_TIME (GeoASN 資料更新日, 0-6 or *, 0代表星期天, *代表每天, default 0)
# GEOASN_UPDATE_DAY_TIME (GeoASN 資料更新小時, 0-23 or *, default 1)
# GEOASN_CUSTOM_URL (GeoASN 資料自定義更新地址, URL or default)

# --- 其它功能 ---
# GLOBAL_UA (全域性 User-Agent, 0:不覆寫，或具體 UA)
# SMALL_FLASH_MEMORY (小快閃記憶體模式, 0: 禁用, 1: 啟用)
# DISABLE_QUIC_GO_GSO (禁用 QUIC GO GSO, 0: 外掛不覆寫, 1: 啟用)
# DELAY_START (延時啟動, 0: 禁用 or 秒數)
# SKIP_PROXY_ADDRESS (跳過代理地址, 0: 禁用, 1: 啟用)
# SUB_INFO_URL (訂閱資訊 URL)
# DOWNLOAD_FILE (下載外部檔案到指定路徑, need URL and path)
# AGE_PUBLIC_KEY (指定配置檔案的 AGE 公鑰)
# AGE_SECRET_KEY (指定配置檔案的 AGE 私鑰)
# RESTART (模組更新後重啟外掛, true: 啟用, false: 禁用)
# =========================

